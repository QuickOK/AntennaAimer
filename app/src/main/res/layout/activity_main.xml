<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.antennaaimer.ArOverlayView
        android:id="@+id/arOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="70dp"
        android:layout_marginStart="12dp"
        android:text="&lt; Targets"
        android:textSize="12sp"
        android:backgroundTint="#CC333333"
        android:textColor="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalibrate"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:text="Point at SUN + tap to calibrate"
        android:textSize="12sp"
        android:backgroundTint="#CCFF6600"
        android:textColor="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecalibrate"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:text="Re-calibrate"
        android:textSize="12sp"
        android:backgroundTint="#CC333333"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSound"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="12dp"
        android:text="&#x1F50A;"
        android:textSize="16sp"
        android:backgroundTint="#CC333333"
        android:textColor="@android:color/white"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />

</FrameLayout>
